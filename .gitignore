# KNHANES (KDCA) raw files are used under KDCA's data-use terms and may not be redistributed.
# Put them in data/knhanes/ on your own machine; only the README there is tracked.
data/knhanes/*
!data/knhanes/README.md
data_private/
*.sas7bdat
*.sav
*.dta
# Pickled model objects run code when loaded; the app uses the JSON files in models/.
*.pkl

# NHANES (CDC) files are public domain and are tracked in data/raw/.

# Secrets
.env
.env.*
!.env.example

# Dependencies and builds
node_modules/
dist/
build/
__pycache__/
*.pyc
.venv/

# OS and editor files
.DS_Store
Thumbs.db
*.tmp
